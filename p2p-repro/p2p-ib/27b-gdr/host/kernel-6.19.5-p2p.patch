 obj-$(CONFIG_PCIE_AL) += pcie-al.o
 obj-$(CONFIG_PCI_HISI) += pcie-hisi.o
 
diff --git a/drivers/pci/p2pdma.c b/drivers/pci/p2pdma.c
index 79a414fd6..963c71ca9 100644
--- a/drivers/pci/p2pdma.c
+++ b/drivers/pci/p2pdma.c
@@ -517,12 +517,22 @@ static void seq_buf_print_bus_devfn(struct seq_buf *buf, struct pci_dev *pdev)
 
 static bool cpu_supports_p2pdma(void)
 {
+	/*
+	 * Phase-4 RISC-V hack: claim CPU supports P2PDMA so calc_map_type_and_dist()
+	 * accepts host-bridge-routed peer paths.  In our QEMU passthrough setup the
+	 * host CPU IS Zen (AMD Ryzen Raphael IO Die) and the host AMD-Vi IOMMU
+	 * has all peer-BAR mappings installed via the Phase-3 iommufd dma-buf path.
+	 * The guest just needs amdgpu to issue the call.
+	 */
+	return true;
 #ifdef CONFIG_X86
-	struct cpuinfo_x86 *c = &cpu_data(0);
+	{
+		struct cpuinfo_x86 *c = &cpu_data(0);
 
-	/* Any AMD CPU whose family ID is Zen or newer supports p2pdma */
-	if (c->x86_vendor == X86_VENDOR_AMD && c->x86 >= 0x17)
-		return true;
+		/* Any AMD CPU whose family ID is Zen or newer supports p2pdma */
+		if (c->x86_vendor == X86_VENDOR_AMD && c->x86 >= 0x17)
+			return true;
+	}
 #endif
 
 	return false;
